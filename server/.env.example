# MongoDB Atlas connection string
dbUrl=

# Long random secret used to sign login cookies
JWT_SECRET=

# Cloudinary credentials for image/video uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production URLs (set these in Render)
CLIENT_URL=https://your-vercel-app.vercel.app
PUBLIC_API_URL=https://your-render-service.onrender.com
NODE_ENV=production
